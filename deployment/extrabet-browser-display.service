[Unit]
Description=Extrabet Backoffice virtual display
After=network.target

[Service]
Type=simple
User=extrabet-bot
Group=extrabet-bot
ExecStart=/usr/bin/Xvfb :99 -screen 0 1440x900x24 -nolisten tcp -noreset
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
