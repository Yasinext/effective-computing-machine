[Unit]
Description=Extrabet temporary local-only browser VNC
After=extrabet-browser-display.service
Requires=extrabet-browser-display.service

[Service]
Type=simple
User=extrabet-bot
Group=extrabet-bot
ExecStart=/usr/bin/x11vnc -display :99 -localhost -forever -shared -nopw -rfbport 5900
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

